# ─────────────────────────────────────────────
#  Altın Fırın — Backend Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# MongoDB connection string
# Local:   mongodb://localhost:27017/altinfirin
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/altinfirin
MONGODB_URI=mongodb://localhost:27017/altinfirin

# Server port
PORT=5000

# JWT secret — change this to a long random string in production!
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_very_long_random_secret_in_production

# JWT expiry (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# Admin credentials (used by seed script to create the first admin)
ADMIN_EMAIL=admin@altinfirin.com
ADMIN_PASSWORD=Admin1234!

# Frontend URL for CORS (no trailing slash)
CLIENT_URL=http://localhost:5173

# Node environment: development | production
NODE_ENV=development
